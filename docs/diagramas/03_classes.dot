Pedido [label=<<TABLE BORDER="1" COLOR="#92acb6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" BGCOLOR="#163e50"><FONT COLOR="white" POINT-SIZE="15"><B>«interface» Pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">id: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">usuarioId: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">unidadeId: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">canalPedido: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">status: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">total: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">criadoEm: Date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">atualizadoEm: Date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">itens: ItemPedido[]</TD></TR></TABLE>>];
