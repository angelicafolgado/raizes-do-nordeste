digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.45", ranksep="1.0", splines=polyline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="24" COLOR="#123447"><B>03 | Classes — visão de domínio</B></FONT><BR/><FONT POINT-SIZE="12" COLOR="#46616f">«interface» = contrato TypeScript • relações por IDs; Pedido contém itens • regras de negócio residem nos casos de uso</FONT><BR/><BR/>>];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=11, color="#71858e", fontcolor="#24475a", penwidth=1.2, arrowsize=0.7];
Consentimento [label=<<TABLE BORDER="1" COLOR="#92acb6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" BGCOLOR="#163e50"><FONT COLOR="white" POINT-SIZE="15"><B>«interface» Consentimento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">id: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">usuarioId: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">finalidade: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">versaoAviso: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">aceito: boolean</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">demonstracao: boolean</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#edf6f5">registradoEm: Date</TD></TR></TABLE>>];
