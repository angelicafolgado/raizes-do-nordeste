{
  "info": {
    "name": "Raízes do Nordeste — fluxo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute a coleção completa em ordem, com banco populado. Cada requisição contém pré-condições e asserções de status/conteúdo. baseUrl padrão http://localhost:3000; tokens e pedidoId são capturados automaticamente. Não há token real salvo na coleção."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "token_cozinha",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "description": "Execute as pastas e suas requisições na ordem apresentada.",
      "item": [
        {
          "name": "T01 - Login cliente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@cliente.com\",\n  \"senha\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pré-condição: API iniciada; migrations e seed aplicados.\nResultado esperado: HTTP 200; accessToken presente; CLIENTE.\nEvidência: asserções da requisição T01 - Login cliente, executada em ordem no Collection Runner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_cliente\", pm.response.json().accessToken);",
                  "pm.test(\"Perfil cliente\", () => pm.expect(pm.response.json().usuario.role).to.eql(\"CLIENTE\"));",
                  "pm.test(\"Token recebido\", () => pm.expect(typeof pm.response.json().accessToken).to.eql(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 - Login cozinha",
