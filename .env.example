PORT=3000
SPRING_DATASOURCE_URL="jdbc:sqlite:raizes.db"
# Exporte as variáveis antes de executar Maven; Spring não carrega .env automaticamente.
# Gere JWT_SECRET com pelo menos 32 caracteres aleatórios. Nunca versionar o valor real.
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO"
JWT_EXPIRES_IN="8h"
SEED_ENABLED=true
