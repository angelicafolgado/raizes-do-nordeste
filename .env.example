PORT=3000
SPRING_DATASOURCE_URL="jdbc:sqlite:raizes.db"
# As variáveis devem ser exportadas antes da execução do Maven; Spring não carrega .env automaticamente.
# JWT_SECRET requer pelo menos 32 caracteres aleatórios. O valor real deve permanecer fora do versionamento.
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO"
JWT_EXPIRES_IN="8h"
SEED_ENABLED=true
